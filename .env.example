# --- Database ---
# Local dev: a Postgres connection string. Managed Postgres (e.g. Render, Neon) works fine.
DATABASE_URL="postgresql://user:password@localhost:5432/meal_prep"

# --- Auth.js ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Kroger API (see README "Kroger developer registration" section) ---
KROGER_CLIENT_ID=""
KROGER_CLIENT_SECRET=""
# Must exactly match the redirect URI registered in the Kroger developer portal.
KROGER_REDIRECT_URI="http://localhost:3000/api/kroger/callback"
# "https://api.kroger.com" in production; Kroger also offers a certification/sandbox host.
KROGER_API_BASE="https://api.kroger.com"

# --- LLM-based ingredient extraction (for messy video captions/transcripts) ---
# Used to turn free-text captions/transcripts into structured ingredient lists.
ANTHROPIC_API_KEY=""

# --- Optional: audio transcription fallback for videos without a usable caption ---
OPENAI_API_KEY=""
